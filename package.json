{
  "name": "salon-booking",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "pnpm -r --workspace-concurrency=1 test",
    "test:engine": "pnpm --filter @salon/engine test",
    "db:migrate": "pnpm --filter @salon/api migrate",
    "seed": "pnpm --filter @salon/api seed",
    "test:api": "pnpm --filter @salon/api test",
    "dev": "pnpm --parallel --filter @salon/api --filter @salon/web dev",
    "test:e2e": "pnpm --filter @salon/e2e e2e",
    "lighthouse": "pnpm --filter @salon/e2e lighthouse",
    "audit": "pnpm audit --prod --audit-level=high"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.20.5",
    "@vitest/coverage-v8": "^3.2.7",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "fast-check": "^4.10.2",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^3.2.7"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "@node-rs/argon2",
      "sharp"
    ]
  }
}
